# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# OpenAI — required for all AI features
OPENAI_API_KEY=sk-...

# Tavily — for real resource search
TAVILY_API_KEY=tvly-...

# Supabase — from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin portal credentials — change before going live
ADMIN_USERNAME=atomcamp_admin
ADMIN_PASSWORD=your-strong-password
ADMIN_SECRET=your-secret-token
